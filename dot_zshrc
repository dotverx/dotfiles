export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="my-frisk"
plugins=(git direnv virtualenv mise)
source $ZSH/oh-my-zsh.sh

set -o vi

export XDG_CONFIG_HOME="${HOME}/.config"

export EDITOR=vim

export PATH="$HOME/.local/bin:$PATH"

if command -v coi >/dev/null 2>&1; then
    source <(coi completion zsh)
fi

if command -v less >/dev/null; then
    export PAGER=less
fi
export LESS="-R -M -i"

export VIRTUAL_ENV_DISABLE_PROMPT=0
function virtualenv_prompt_info {
    [[ -n "${VIRTUAL_ENV:-}" ]] && echo "[$VIRTUAL_ENV] "
}

setup_venv() {
    if [[ -n "${VIRTUAL_ENV:-}" && -d "${VIRTUAL_ENV}/bin" ]]; then
        . "${VIRTUAL_ENV}"/bin/activate
    elif [[ -z "${VIRTUAL_ENV:-}" ]] && command -v deactivate > /dev/null; then
        deactivate
    fi
}
add-zsh-hook chpwd setup_venv
setup_venv

bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' forward-word

autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
# vim normal mode: k/j search by the typed prefix
bindkey -M vicmd 'k' up-line-or-beginning-search
bindkey -M vicmd 'j' down-line-or-beginning-search
# make arrow keys behave the same in normal mode
bindkey -M vicmd $'\e[A' up-line-or-beginning-search
bindkey -M vicmd $'\e[B' down-line-or-beginning-search

alias k=kubectl
alias h=helm
alias i=incus

alias ls="ls -AF --color=auto --group-directories-first"
alias lr="ls -R"

yazi() {
    set -- "$@" --cwd-file "$(mktemp -t yazi-cwd.XXXXXX)"
    command yazi "$@"
    shift $(($# - 1))
    set -- "$(command cat < "$1"; printf .; rm -f -- "$1")"
    set -- "${1%.}"
    [ "$1" != "$PWD" ] && [ -d "$1" ] && builtin cd -- "$1"
}

if [ -z "${SSH_CONNECTION}" ]; then
    export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
fi

cht () {
    if [[ "${#}" -eq 0 ]]; then
        printf "%s\n" \
            "Usage: cht <topic> [query...]" \
            "Examples: cht tar | cht tar extract | cht tar~extract | cht go/zip lists | cht '~extract'" \
            >&2
        return 1
    fi
    # change spaces to + for request
    # it breaks on special characters ?#%&
    local q="${*// /+}"
    local url="https://cht.sh"
    if [[ -t 1 ]] && command -v less >/dev/null; then
        curl -fsSL "${url}/${q}" | less -R
    else
        curl -fsSL "${url}/${q}"
    fi
}

chezmoi-print () {
    printf '%s\n' \
        'sh -c "$(curl -fsLS https://get.chezmoi.io)" -- init --apply https://github.com/dotverx/dotfiles.git'
}

pull-coi () {
    git clone --depth 1 https://github.com/dotverx/coi-repo.git
}

pull-python () {
    git clone --depth 1 https://github.com/dotverx/python-repo.git
}
